##NAME CSV outer joins, expression sources

# Show when joins are pushed down to MySQL
test 1

# csv_outer_kardia_inner_side
csv select :a:f_id, :a:f_desc, pk = :c:p_partner_key, cid = :c:p_contact_id from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c where :a:f_id *= :c:p_contact_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :a:f_id, :c:p_partner_key
csv set passthrough 0 select :a:f_id, :a:f_desc, pk = :c:p_partner_key, cid = :c:p_contact_id from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c where :a:f_id *= :c:p_contact_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :a:f_id, :c:p_partner_key

# kardia_outer_csv
csv select :l:p_partner_key, :l:p_location_id, :l:p_state_province, full = :s:full_name from /tests/Test_DB/p_location/rows l, /tests/States.csv/rows s where :l:p_state_province *= :s:abbrev and :l:p_partner_key >= '100000' and :l:p_partner_key < '100020' and :l:p_revision_id = 0 order by :l:p_partner_key, :l:p_location_id
csv set passthrough 0 select :l:p_partner_key, :l:p_location_id, :l:p_state_province, full = :s:full_name from /tests/Test_DB/p_location/rows l, /tests/States.csv/rows s where :l:p_state_province *= :s:abbrev and :l:p_partner_key >= '100000' and :l:p_partner_key < '100020' and :l:p_revision_id = 0 order by :l:p_partner_key, :l:p_location_id

# csv_outer_first_then_two_kardia
csv select :a:f_id, :a:f_desc, pk = :c:p_partner_key, cid = :c:p_contact_id, ptype = :ct:text from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :a:f_id *= :c:p_contact_id and :c:p_partner_key >= '100002' and :c:p_partner_key < '100006' and :ct:tag = :c:p_contact_type order by :a:f_id, :c:p_partner_key, :c:p_contact_id
csv set passthrough 0 select :a:f_id, :a:f_desc, pk = :c:p_partner_key, cid = :c:p_contact_id, ptype = :ct:text from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :a:f_id *= :c:p_contact_id and :c:p_partner_key >= '100002' and :c:p_partner_key < '100006' and :ct:tag = :c:p_contact_type order by :a:f_id, :c:p_partner_key, :c:p_contact_id

# csv_first_outer_two_kardia_leaf
csv select :a:f_id, pk = :c:p_partner_key, cid = :c:p_contact_id, pl = :l:p_location_id from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :a:f_id = :c:p_contact_id and :c:p_partner_key *= :l:p_partner_key and :c:p_partner_key >= '100002' and :c:p_partner_key < '100010' order by :a:f_id, :c:p_partner_key, :c:p_contact_id, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :a:f_id, pk = :c:p_partner_key, cid = :c:p_contact_id, pl = :l:p_location_id from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :a:f_id = :c:p_contact_id and :c:p_partner_key *= :l:p_partner_key and :c:p_partner_key >= '100002' and :c:p_partner_key < '100010' order by :a:f_id, :c:p_partner_key, :c:p_contact_id, :l:p_location_id, :l:p_revision_id

# mixed_expression_source_and_plain
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id from /tests/Test_DB/p_partner/rows p, expression ('/tests/Test_DB/p_location/rows') l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100010' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id from /tests/Test_DB/p_partner/rows p, expression ('/tests/Test_DB/p_location/rows') l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100010' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# mixed_expression_first_then_plain_pair
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id from expression ('/tests/Test_DB/p_partner/rows') p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100010' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id from expression ('/tests/Test_DB/p_partner/rows') p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100010' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# three_way_inner_with_outer_leaf_and_csv_const
csv select :p:p_partner_key, :l:p_location_id, don = :d:p_partner_key, :s:abbrev from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_donor/rows d, /tests/States.csv/rows s where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key *= :d:p_partner_key and :s:abbrev = :l:p_state_province and :p:p_partner_key >= '100000' and :p:p_partner_key < '100025' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, don = :d:p_partner_key, :s:abbrev from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_donor/rows d, /tests/States.csv/rows s where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key *= :d:p_partner_key and :s:abbrev = :l:p_state_province and :p:p_partner_key >= '100000' and :p:p_partner_key < '100025' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
