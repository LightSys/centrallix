##NAME MySQL join pushdown, cases 001-010

# Show when joins are pushed down to MySQL
test 1

# 001_inner2_basic
csv select :p:p_partner_key, :p:p_surname, :l:p_location_id, :l:p_revision_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, :l:p_location_id, :l:p_revision_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 002_inner3_chain_c_joins_l
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, :c:p_contact_type from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, :c:p_contact_type from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 003_inner3_star_l_c_join_p
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 004_inner4_chain_with_lookup
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, ctype = :ct:text from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :ct:tag = :c:p_contact_type and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, ctype = :ct:text from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :ct:tag = :c:p_contact_type and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 005_inner6_partner_loc_contact_lookups_country
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, ctype = :ct:text, ltype = :lt:text, cn = :co:p_country_name from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct, /tests/Test_DB/_p_location_type/rows lt, /tests/Test_DB/p_country/rows co where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :ct:tag = :c:p_contact_type and :lt:tag = :l:p_location_type and :co:p_country_code = :l:p_country_code and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, ctype = :ct:text, ltype = :lt:text, cn = :co:p_country_name from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct, /tests/Test_DB/_p_location_type/rows lt, /tests/Test_DB/p_country/rows co where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :l:p_partner_key and :ct:tag = :c:p_contact_type and :lt:tag = :l:p_location_type and :co:p_country_code = :l:p_country_code and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 006_inner5_star_p_hub
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, d_key = :d:p_partner_key, :n:p_nondup_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_dup/rows d, /tests/Test_DB/p_nondup/rows n where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :d:p_partner_key = :p:p_partner_key and :n:p_partner_key = :p:p_partner_key order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id, :d:p_dup_partner_key, :n:p_nondup_partner_key
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, d_key = :d:p_partner_key, :n:p_nondup_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_dup/rows d, /tests/Test_DB/p_nondup/rows n where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :d:p_partner_key = :p:p_partner_key and :n:p_partner_key = :p:p_partner_key order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id, :d:p_dup_partner_key, :n:p_nondup_partner_key

# 007_inner2_acct_string_keys
csv select :t:a_batch_number, :t:a_transaction_number, :a:a_acct_desc, :t:a_amount from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_account/rows a where :a:a_ledger_number = :t:a_ledger_number and :a:a_account_code = :t:a_account_code order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number
csv set passthrough 0 select :t:a_batch_number, :t:a_transaction_number, :a:a_acct_desc, :t:a_amount from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_account/rows a where :a:a_ledger_number = :t:a_ledger_number and :a:a_account_code = :t:a_account_code order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number

# 008_inner3_acct_fund_period_datetime_ge
csv select :t:a_transaction_number, :f:a_fund_desc, :pe:a_period, :t:a_effective_date, :pe:a_start_date from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_fund/rows f, /tests/Test_DB/a_period/rows pe where :f:a_ledger_number = :t:a_ledger_number and :f:a_fund = :t:a_fund and :pe:a_ledger_number = :t:a_ledger_number and :t:a_effective_date >= :pe:a_start_date and :t:a_effective_date <= :pe:a_end_date and :pe:a_summary_only = 0 order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :pe:a_period
csv set passthrough 0 select :t:a_transaction_number, :f:a_fund_desc, :pe:a_period, :t:a_effective_date, :pe:a_start_date from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_fund/rows f, /tests/Test_DB/a_period/rows pe where :f:a_ledger_number = :t:a_ledger_number and :f:a_fund = :t:a_fund and :pe:a_ledger_number = :t:a_ledger_number and :t:a_effective_date >= :pe:a_start_date and :t:a_effective_date <= :pe:a_end_date and :pe:a_summary_only = 0 order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :pe:a_period

# 009_datetime_eq_selfjoin
csv select p1 = :p1:a_period, p2 = :p2:a_period, :p1:a_start_date from /tests/Test_DB/a_period/rows p1, /tests/Test_DB/a_period/rows p2 where :p1:a_start_date = :p2:a_start_date and :p1:a_period < :p2:a_period order by :p1:a_period, :p2:a_period
csv set passthrough 0 select p1 = :p1:a_period, p2 = :p2:a_period, :p1:a_start_date from /tests/Test_DB/a_period/rows p1, /tests/Test_DB/a_period/rows p2 where :p1:a_start_date = :p2:a_start_date and :p1:a_period < :p2:a_period order by :p1:a_period, :p2:a_period

# 010_datetime_containment_two_cmp
csv select inner_p = :p1:a_period, outer_p = :p2:a_period from /tests/Test_DB/a_period/rows p1, /tests/Test_DB/a_period/rows p2 where :p1:a_start_date >= :p2:a_start_date and :p1:a_end_date <= :p2:a_end_date and :p1:a_period != :p2:a_period order by :p1:a_period, :p2:a_period
csv set passthrough 0 select inner_p = :p1:a_period, outer_p = :p2:a_period from /tests/Test_DB/a_period/rows p1, /tests/Test_DB/a_period/rows p2 where :p1:a_start_date >= :p2:a_start_date and :p1:a_end_date <= :p2:a_end_date and :p1:a_period != :p2:a_period order by :p1:a_period, :p2:a_period
