##NAME MySQL join pushdown, cases 168-177

# Show when joins are pushed down to MySQL
test 1

# 168_csv_first_outer_two_kardia_leaf
csv select :a:f_id, pk = :c:p_partner_key, cid = :c:p_contact_id, pl = :l:p_location_id from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :a:f_id = :c:p_contact_id and :c:p_partner_key *= :l:p_partner_key and :c:p_partner_key >= '100002' and :c:p_partner_key < '100010' order by :a:f_id, :c:p_partner_key, :c:p_contact_id, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :a:f_id, pk = :c:p_partner_key, cid = :c:p_contact_id, pl = :l:p_location_id from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :a:f_id = :c:p_contact_id and :c:p_partner_key *= :l:p_partner_key and :c:p_partner_key >= '100002' and :c:p_partner_key < '100010' order by :a:f_id, :c:p_partner_key, :c:p_contact_id, :l:p_location_id, :l:p_revision_id

# 169_outer_star_lookups_l_lt_co_p
csv select :p:p_partner_key, :l:p_location_id, ltype = :lt:text, cn = :co:p_country_name from /tests/Test_DB/p_location/rows l, /tests/Test_DB/_p_location_type/rows lt, /tests/Test_DB/p_country/rows co, /tests/Test_DB/p_partner/rows p where :l:p_location_type *= :lt:tag and :l:p_country_code *= :co:p_country_code and :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, ltype = :lt:text, cn = :co:p_country_name from /tests/Test_DB/p_location/rows l, /tests/Test_DB/_p_location_type/rows lt, /tests/Test_DB/p_country/rows co, /tests/Test_DB/p_partner/rows p where :l:p_location_type *= :lt:tag and :l:p_country_code *= :co:p_country_code and :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 170_outer_selfjoin_nonequi_extra_filter
csv select k1 = :l1:p_partner_key, a = :l1:p_location_id, b = :l2:p_location_id from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_partner_key *= :l2:p_partner_key and :l1:p_location_id < :l2:p_location_id and :l1:p_revision_id = 0 and :l2:p_revision_id = 0 and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100014' order by :l1:p_partner_key, :l1:p_location_id, :l2:p_location_id
csv set passthrough 0 select k1 = :l1:p_partner_key, a = :l1:p_location_id, b = :l2:p_location_id from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_partner_key *= :l2:p_partner_key and :l1:p_location_id < :l2:p_location_id and :l1:p_revision_id = 0 and :l2:p_revision_id = 0 and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100014' order by :l1:p_partner_key, :l1:p_location_id, :l2:p_location_id

# 171_outer_selfjoin_surname_different_key
csv select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key, :p1:p_surname from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname *= :p2:p_surname and :p1:p_partner_key != :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100009' order by :p1:p_partner_key, :p2:p_partner_key
csv set passthrough 0 select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key, :p1:p_surname from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname *= :p2:p_surname and :p1:p_partner_key != :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100009' order by :p1:p_partner_key, :p2:p_partner_key

# 172_name_of_this_table_vs_earlier_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:name = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:name = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 173_name_of_earlier_table_vs_this_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_partner_key = :p:name and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_partner_key = :p:name and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 174_function_on_this_col_vs_earlier_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where rtrim(:l:p_partner_key) = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where rtrim(:l:p_partner_key) = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 175_convert_both_sides_int_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where convert(integer, :l:p_partner_key) = convert(integer, :p:p_partner_key) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where convert(integer, :l:p_partner_key) = convert(integer, :p:p_partner_key) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 176_int_col_vs_string_col_cross_declines
csv select :p:p_partner_key, :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_location_id = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_location_id = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# 177_join_cond_inside_or_with_literal
csv select :p:p_partner_key, :l:p_location_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where (:l:p_partner_key = :p:p_partner_key or :l:p_city = 'Colorado Springs') and :p:p_partner_key >= '100000' and :p:p_partner_key < '100005' and :l:p_partner_key < '100020' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where (:l:p_partner_key = :p:p_partner_key or :l:p_city = 'Colorado Springs') and :p:p_partner_key >= '100000' and :p:p_partner_key < '100005' and :l:p_partner_key < '100020' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
