##NAME MySQL join pushdown, cases 127-136

# Show when joins are pushed down to MySQL
test 1

# 127_datetime_created_eq_partner_location
csv select :p:p_partner_key, :l:p_location_id, :p:s_date_created from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:s_date_created = :l:s_date_created and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :p:s_date_created from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:s_date_created = :l:s_date_created and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 128_datetime_created_lt_cross_no_key
csv select k1 = :p:p_partner_key, k2 = :c:p_partner_key, :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_contact_info/rows c where :c:s_date_created < :p:s_date_created and :p:p_partner_key >= '100000' and :p:p_partner_key < '100012' and :c:p_partner_key >= '100000' and :c:p_partner_key < '100006' order by :p:p_partner_key, :c:p_partner_key, :c:p_contact_id
csv set passthrough 0 select k1 = :p:p_partner_key, k2 = :c:p_partner_key, :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_contact_info/rows c where :c:s_date_created < :p:s_date_created and :p:p_partner_key >= '100000' and :p:p_partner_key < '100012' and :c:p_partner_key >= '100000' and :c:p_partner_key < '100006' order by :p:p_partner_key, :c:p_partner_key, :c:p_contact_id

# 129_datetime_vs_period_start
csv select :p:p_partner_key, :pe:a_period, :p:s_date_created, :pe:a_start_date from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/a_period/rows pe where :p:s_date_created >= :pe:a_start_date and :p:s_date_created <= :pe:a_end_date and :pe:a_summary_only = 0 and :p:p_partner_key >= '100020' and :p:p_partner_key < '100045' order by :p:p_partner_key, :pe:a_period
csv set passthrough 0 select :p:p_partner_key, :pe:a_period, :p:s_date_created, :pe:a_start_date from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/a_period/rows pe where :p:s_date_created >= :pe:a_start_date and :p:s_date_created <= :pe:a_end_date and :pe:a_summary_only = 0 and :p:p_partner_key >= '100020' and :p:p_partner_key < '100045' order by :p:p_partner_key, :pe:a_period

# 130_money_eq_cross_table
csv select :t:a_batch_number, :t:a_transaction_number, :t:a_amount, gi = :g:a_amount from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_subtrx_gift_item/rows g where :t:a_amount = :g:a_amount order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :g:a_batch_number, :g:a_gift_number, :g:a_split_number
csv set passthrough 0 select :t:a_batch_number, :t:a_transaction_number, :t:a_amount, gi = :g:a_amount from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_subtrx_gift_item/rows g where :t:a_amount = :g:a_amount order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :g:a_batch_number, :g:a_gift_number, :g:a_split_number

# 131_money_gt_cross_table
csv select :t:a_transaction_number, :t:a_amount, gi = :g:a_amount from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_subtrx_gift_item/rows g where :t:a_amount > :g:a_amount order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :g:a_batch_number, :g:a_gift_number, :g:a_split_number
csv set passthrough 0 select :t:a_transaction_number, :t:a_amount, gi = :g:a_amount from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_subtrx_gift_item/rows g where :t:a_amount > :g:a_amount order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :g:a_batch_number, :g:a_gift_number, :g:a_split_number

# 132_string_lt_cross_collation_narrow
csv select k1 = :p:p_partner_key, k2 = :l:p_partner_key, :p:p_surname, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname < :l:p_city and :p:p_partner_key >= '100004' and :p:p_partner_key < '100018' and :l:p_partner_key >= '100013' and :l:p_partner_key < '100016' and :l:p_revision_id = 0 order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id
csv set passthrough 0 select k1 = :p:p_partner_key, k2 = :l:p_partner_key, :p:p_surname, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname < :l:p_city and :p:p_partner_key >= '100004' and :p:p_partner_key < '100018' and :l:p_partner_key >= '100013' and :l:p_partner_key < '100016' and :l:p_revision_id = 0 order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id

# 133_string_ne_cross_collation_narrow
csv select k1 = :p:p_partner_key, k2 = :l:p_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname != :l:p_city and :p:p_partner_key >= '100004' and :p:p_partner_key < '100010' and :l:p_partner_key >= '100005' and :l:p_partner_key < '100007' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select k1 = :p:p_partner_key, k2 = :l:p_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname != :l:p_city and :p:p_partner_key >= '100004' and :p:p_partner_key < '100010' and :l:p_partner_key >= '100005' and :l:p_partner_key < '100007' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# 134_string_ge_selfjoin_surname
csv select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname >= :p2:p_surname and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100011' and :p2:p_partner_key >= '100000' and :p2:p_partner_key < '100011' order by :p1:p_partner_key, :p2:p_partner_key
csv set passthrough 0 select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname >= :p2:p_surname and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100011' and :p2:p_partner_key >= '100000' and :p2:p_partner_key < '100011' order by :p1:p_partner_key, :p2:p_partner_key

# 135_outer_nonequi_selfjoin
csv select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_partner_key *= :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100030' order by :p1:p_partner_key, :p2:p_partner_key
csv set passthrough 0 select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_partner_key *= :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100030' order by :p1:p_partner_key, :p2:p_partner_key

# 136_outer_cross_collation_surname_city
csv select :p:p_partner_key, :p:p_surname, lk = :l:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname *= :l:p_city and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' and :p:p_partner_class = 'IND' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, lk = :l:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname *= :l:p_city and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' and :p:p_partner_class = 'IND' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
