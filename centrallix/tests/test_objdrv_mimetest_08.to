##NAME MimeTest external-body parameters

query select :name, :inner_type from object /tests/mimetest/EM6.2.eml
query select :name, :inner_type, access = :"Content-Type.access-type", site = :"Content-Type.site", directory = :"Content-Type.directory", server = :"Content-Type.server" from /tests/mimetest/EM6.2.eml
query select :name, start = substring(:objcontent, 1, 24) from /tests/mimetest/EM6.2.eml
