##NAME MySQL join pushdown, cases 094-103

# Show when joins are pushed down to MySQL
test 1

# 094_size_big_p_l_unfiltered
csv select :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100065' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100065' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 095_size_big_p_l_c_outer
csv select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :p:p_partner_key *= :c:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100050' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :p:p_partner_key *= :c:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100050' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 096_zero_rows_join_mismatch
csv select :p:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_class = 'CHU' and :l:p_country_code = 'ZZ' order by :p:p_partner_key
csv set passthrough 0 select :p:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_class = 'CHU' and :l:p_country_code = 'ZZ' order by :p:p_partner_key

