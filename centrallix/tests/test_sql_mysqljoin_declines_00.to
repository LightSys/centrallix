##NAME Conditions that decline pushdown

# Show when joins are pushed down to MySQL
test 1

# outer_convert_on_earlier_declines
csv select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and convert(integer, :c:p_location_id) *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and convert(integer, :c:p_location_id) *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id

# func_on_earlier_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_partner_key = upper(:p:p_partner_key) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100025' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_partner_key = upper(:p:p_partner_key) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100025' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# arith_on_earlier_col_declines
csv select k = :l1:p_partner_key, a = :l1:p_location_id, b = :l2:p_location_id from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l2:p_partner_key = :l1:p_partner_key and :l2:p_location_id = :l1:p_location_id + 1 and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100060' order by :l1:p_partner_key, :l1:p_location_id, :l1:p_revision_id, :l2:p_revision_id
csv set passthrough 0 select k = :l1:p_partner_key, a = :l1:p_location_id, b = :l2:p_location_id from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l2:p_partner_key = :l1:p_partner_key and :l2:p_location_id = :l1:p_location_id + 1 and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100060' order by :l1:p_partner_key, :l1:p_location_id, :l1:p_revision_id, :l2:p_revision_id

# name_pk_of_earlier_declines
csv select :nd:p_partner_key, :nd:p_nondup_partner_key, k2 = :nd2:p_partner_key from /tests/Test_DB/p_nondup/rows nd, /tests/Test_DB/p_nondup/rows nd2 where :nd2:name = :nd:name order by :nd:p_partner_key, :nd:p_nondup_partner_key
csv set passthrough 0 select :nd:p_partner_key, :nd:p_nondup_partner_key, k2 = :nd2:p_partner_key from /tests/Test_DB/p_nondup/rows nd, /tests/Test_DB/p_nondup/rows nd2 where :nd2:name = :nd:name order by :nd:p_partner_key, :nd:p_nondup_partner_key

# or_across_sources
csv select :p:p_partner_key, :p:p_partner_class, :l:p_location_type, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and (:p:p_partner_class = 'CHU' or :l:p_location_type = 'W') and :p:p_partner_key < '102000' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_partner_class, :l:p_location_type, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and (:p:p_partner_class = 'CHU' or :l:p_location_type = 'W') and :p:p_partner_key < '102000' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# name_of_this_table_vs_earlier_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:name = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:name = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# name_of_earlier_table_vs_this_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_partner_key = :p:name and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_partner_key = :p:name and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# function_on_this_col_vs_earlier_col_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where rtrim(:l:p_partner_key) = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where rtrim(:l:p_partner_key) = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# convert_both_sides_int_declines
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where convert(integer, :l:p_partner_key) = convert(integer, :p:p_partner_key) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where convert(integer, :l:p_partner_key) = convert(integer, :p:p_partner_key) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100014' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# int_col_vs_string_col_cross_declines
csv select :p:p_partner_key, :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_location_id = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :l:p_location_id = :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100040' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
