##NAME Restarted while deferred
##UNDO /tests/spool/smtp/Bounced.struct
##UNDO /tests/spool/smtp/Deferred.struct
##UNDO /tests/spool/smtp/DeferredSent.struct
##UNDO /tests/spool/smtp/Expired.struct
##UNDO /tests/spool/smtp/PartialBounce.struct
##UNDO /tests/spool/smtp/Resent.struct
##UNDO /tests/spool/smtp/Restarted.struct
##UNDO /tests/spool/smtp/Sent.struct
##UNDO /tests/spool/smtp/.mail_log_cursor
##UNDO /tests/spool/smtp/.spool_lock

query select :name, :status, :last_try_status, :last_try_msg from /tests/smtp/emails.smtp where :name = 'Restarted.eml'
