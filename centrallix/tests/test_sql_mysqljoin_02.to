# 020_outer_leaf_then_inner_lookup_country
csv select :l:p_partner_key, :l:p_location_id, ltype = :lt:text, cn = :co:p_country_name from /tests/Test_DB/p_location/rows l, /tests/Test_DB/_p_location_type/rows lt, /tests/Test_DB/p_country/rows co where :l:p_location_type *= :lt:tag and :co:p_country_code = :l:p_country_code and :l:p_partner_key >= '100000' and :l:p_partner_key < '100020' order by :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :l:p_partner_key, :l:p_location_id, ltype = :lt:text, cn = :co:p_country_name from /tests/Test_DB/p_location/rows l, /tests/Test_DB/_p_location_type/rows lt, /tests/Test_DB/p_country/rows co where :l:p_location_type *= :lt:tag and :co:p_country_code = :l:p_country_code and :l:p_partner_key >= '100000' and :l:p_partner_key < '100020' order by :l:p_partner_key, :l:p_location_id, :l:p_revision_id
