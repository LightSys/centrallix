##NAME MySQL join pushdown, cases 011-020

# Show when joins are pushed down to MySQL
test 1

# 011_datetime_trx_eq_period_end
csv select :t:a_transaction_number, :pe:a_period, :pe:a_end_date, :t:a_effective_date from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_period/rows pe where :t:a_effective_date < :pe:a_end_date and :pe:a_summary_only = 0 and :pe:a_period >= '2011.03' and :pe:a_period <= '2011.04' order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :pe:a_period
csv set passthrough 0 select :t:a_transaction_number, :pe:a_period, :pe:a_end_date, :t:a_effective_date from /tests/Test_DB/a_transaction/rows t, /tests/Test_DB/a_period/rows pe where :t:a_effective_date < :pe:a_end_date and :pe:a_summary_only = 0 and :pe:a_period >= '2011.03' and :pe:a_period <= '2011.04' order by :t:a_batch_number, :t:a_journal_number, :t:a_transaction_number, :pe:a_period

# 012_outer_leaf_p_l
csv select :p:p_partner_key, :p:p_surname, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 013_outer_leaf_const_filter_rev0
csv select :p:p_partner_key, loc = :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :l:p_revision_id = 0 and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :l:p_revision_id = 0 and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 014_outer_leaf_filter_or_null
csv select :p:p_partner_key, loc = :l:p_location_id, ltype = :l:p_location_type from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and (:l:p_location_type = 'W' or :l:p_location_type is null) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, ltype = :l:p_location_type from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and (:l:p_location_type = 'W' or :l:p_location_type is null) and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 015_outer_matches_nothing_nondup
csv select :p:p_partner_key, nd = :n:p_nondup_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_nondup/rows n where :p:p_partner_key *= :n:p_partner_key and :p:p_partner_key >= '100008' and :p:p_partner_key < '100022' order by :p:p_partner_key, :n:p_nondup_partner_key
csv set passthrough 0 select :p:p_partner_key, nd = :n:p_nondup_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_nondup/rows n where :p:p_partner_key *= :n:p_partner_key and :p:p_partner_key >= '100008' and :p:p_partner_key < '100022' order by :p:p_partner_key, :n:p_nondup_partner_key

# 016_outer_empty_table_p_staff
csv select :p:p_partner_key, st = :s:p_kardia_login from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_staff/rows s where :p:p_partner_key *= :s:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100030' order by :p:p_partner_key
csv set passthrough 0 select :p:p_partner_key, st = :s:p_kardia_login from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_staff/rows s where :p:p_partner_key *= :s:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100030' order by :p:p_partner_key

# 017_chained_outer_p_l_c
csv select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :l:p_partner_key *= :c:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :l:p_partner_key *= :c:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 018_outer_with_inner_dependent
csv select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :l:p_partner_key = :c:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :l:p_partner_key = :c:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

