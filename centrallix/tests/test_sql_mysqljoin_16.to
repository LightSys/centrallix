# 163_chain10_ledger_selfjoin
csv select :a:a_ledger_number, :j:a_ledger_desc from /tests/Test_DB/a_ledger/rows a, /tests/Test_DB/a_ledger/rows b, /tests/Test_DB/a_ledger/rows c, /tests/Test_DB/a_ledger/rows d, /tests/Test_DB/a_ledger/rows e, /tests/Test_DB/a_ledger/rows f, /tests/Test_DB/a_ledger/rows g, /tests/Test_DB/a_ledger/rows h, /tests/Test_DB/a_ledger/rows i, /tests/Test_DB/a_ledger/rows j where :b:a_ledger_number = :a:a_ledger_number and :c:a_ledger_number = :b:a_ledger_number and :d:a_ledger_number = :c:a_ledger_number and :e:a_ledger_number = :d:a_ledger_number and :f:a_ledger_number = :e:a_ledger_number and :g:a_ledger_number = :f:a_ledger_number and :h:a_ledger_number = :g:a_ledger_number and :i:a_ledger_number = :h:a_ledger_number and :j:a_ledger_number = :i:a_ledger_number
csv set passthrough 0 select :a:a_ledger_number, :j:a_ledger_desc from /tests/Test_DB/a_ledger/rows a, /tests/Test_DB/a_ledger/rows b, /tests/Test_DB/a_ledger/rows c, /tests/Test_DB/a_ledger/rows d, /tests/Test_DB/a_ledger/rows e, /tests/Test_DB/a_ledger/rows f, /tests/Test_DB/a_ledger/rows g, /tests/Test_DB/a_ledger/rows h, /tests/Test_DB/a_ledger/rows i, /tests/Test_DB/a_ledger/rows j where :b:a_ledger_number = :a:a_ledger_number and :c:a_ledger_number = :b:a_ledger_number and :d:a_ledger_number = :c:a_ledger_number and :e:a_ledger_number = :d:a_ledger_number and :f:a_ledger_number = :e:a_ledger_number and :g:a_ledger_number = :f:a_ledger_number and :h:a_ledger_number = :g:a_ledger_number and :i:a_ledger_number = :h:a_ledger_number and :j:a_ledger_number = :i:a_ledger_number

# 165_two_groups_csv_between_runs
csv select :p:p_partner_key, :l:p_location_id, :s:abbrev, :c:p_contact_id, :ct:text from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/States.csv/rows s, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :l:p_partner_key = :p:p_partner_key and :s:abbrev = :l:p_state_province and :c:p_partner_key = :p:p_partner_key and :ct:tag = :c:p_contact_type and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :s:abbrev, :c:p_contact_id, :ct:text from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/States.csv/rows s, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :l:p_partner_key = :p:p_partner_key and :s:abbrev = :l:p_state_province and :c:p_partner_key = :p:p_partner_key and :ct:tag = :c:p_contact_type and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# 166_csv_state_then_second_loc_same_state
csv select :s:abbrev, :p:p_partner_key, :l:p_location_id, k2 = :l2:p_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/States.csv/rows s, /tests/Test_DB/p_location/rows l2 where :l:p_partner_key = :p:p_partner_key and :s:abbrev = :l:p_state_province and :l2:p_state_province = :s:abbrev and :l2:p_partner_key != :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100003' and :l2:p_partner_key < '100030' and :l:p_revision_id = 0 and :l2:p_revision_id = 0 order by :p:p_partner_key, :l:p_location_id, :l2:p_partner_key, :l2:p_location_id
csv set passthrough 0 select :s:abbrev, :p:p_partner_key, :l:p_location_id, k2 = :l2:p_partner_key from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/States.csv/rows s, /tests/Test_DB/p_location/rows l2 where :l:p_partner_key = :p:p_partner_key and :s:abbrev = :l:p_state_province and :l2:p_state_province = :s:abbrev and :l2:p_partner_key != :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100003' and :l2:p_partner_key < '100030' and :l:p_revision_id = 0 and :l2:p_revision_id = 0 order by :p:p_partner_key, :l:p_location_id, :l2:p_partner_key, :l2:p_location_id

# 167_csv_outer_first_then_two_kardia
csv select :a:f_id, :a:f_desc, pk = :c:p_partner_key, cid = :c:p_contact_id, ptype = :ct:text from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :a:f_id *= :c:p_contact_id and :c:p_partner_key >= '100002' and :c:p_partner_key < '100006' and :ct:tag = :c:p_contact_type order by :a:f_id, :c:p_partner_key, :c:p_contact_id
csv set passthrough 0 select :a:f_id, :a:f_desc, pk = :c:p_partner_key, cid = :c:p_contact_id, ptype = :ct:text from /tests/Testdata1.csv/rows a, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :a:f_id *= :c:p_contact_id and :c:p_partner_key >= '100002' and :c:p_partner_key < '100006' and :ct:tag = :c:p_contact_type order by :a:f_id, :c:p_partner_key, :c:p_contact_id
