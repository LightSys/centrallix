##NAME SQL Temp Collection Indexing with Guards and Functions

# Enable index and scan output
test 3,4

query declare collection t scope application; insert into collection t select id = :s:id, abbrev = :s:abbrev, state = :s:full_name from /tests/States.csv/rows s; declare collection u scope application; insert into collection u select p = condition(:s:id = 1, null, condition(:s:id = 2, 5, 99)), w = condition(:s:id = 2, 'CA', 'AK') from /tests/States.csv/rows s where :s:id <= 3; select n = count(1) from collection u, collection t where (:u:p is null or :t:id = :u:p)
query select n = count(1) from collection u, collection t where (:u:p is null or :t:id = :u:p) and :t:abbrev != :u:w
query select n = count(1) from collection u, collection t where (:u:p is null or (:t:id = :u:p and :t:abbrev = :u:w))
query select n = count(1) from collection u, collection t where (:t:id = :u:p or :u:p is null)
query exec /tests/collparam_guard.qy (src = collection t, id = 5)
query exec /tests/collparam_guard.qy (src = collection t)
query select n = count(1) from collection t where :id = convert(integer, '5') and :abbrev = upper('ca')
query select n = count(1) from collection t where :id = convert(integer, rand() * 0 + 5)
query select n = count(1) from collection t where (rand() < 0 or :id = 5)
query select n = count(1) from collection t where :id = (select max(:id) from /tests/States.csv/rows where :id = 5)
query select n = count(1) from collection t where (:id = 5 or :id = 6)
query select n = count(1) from collection t where (1 = 1 or :id = 5)
query select n = count(1) from collection t where (1 = 0 or :id = 5)
query declare collection v scope application; insert into collection v select q = :s:id from /tests/States.csv/rows s where :s:id <= 5; select s = sum(:t:id) from collection v, collection t where :t:id = convert(integer, :v:q)
query select s = sum(:t:id) from collection v, collection t where (:v:q is null or :t:id = :v:q + 0)
