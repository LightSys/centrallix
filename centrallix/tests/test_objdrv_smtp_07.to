##NAME Open an email by its path
##UNDO /tests/smtp/spool/Bounced.struct
##UNDO /tests/smtp/spool/Deferred.struct
##UNDO /tests/smtp/spool/DeferredSent.struct
##UNDO /tests/smtp/spool/Expired.struct
##UNDO /tests/smtp/spool/PartialBounce.struct
##UNDO /tests/smtp/spool/Resent.struct
##UNDO /tests/smtp/spool/Restarted.struct
##UNDO /tests/smtp/spool/Sent.struct
##UNDO /tests/smtp/spool/.mail_log_cursor
##UNDO /tests/smtp/spool/.spool_lock

query select :name, :status, :last_try_status, :envelope_from, :Subject from object /tests/smtp/emails.smtp/Sent.eml
