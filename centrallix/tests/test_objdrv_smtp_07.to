##NAME Open an email by its path
##UNDO /tests/spool/smtp/6ce5e6456e3544ee/Bounced.struct
##UNDO /tests/spool/smtp/6ce5e6456e3544ee/Deferred.struct
##UNDO /tests/spool/smtp/6ce5e6456e3544ee/DeferredSent.struct
##UNDO /tests/spool/smtp/6ce5e6456e3544ee/Expired.struct
