##NAME MySQL join pushdown, cases 021-030

# Show when joins are pushed down to MySQL
test 1

# 021_outer_inner_p_l_then_outer_donor
csv select :p:p_partner_key, :l:p_location_id, don = :d:p_partner_key, :d:p_is_daf from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_donor/rows d where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key *= :d:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, don = :d:p_partner_key, :d:p_is_daf from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_donor/rows d where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key *= :d:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 022_outer_reverse_eqstar
csv select :p:p_partner_key, :p:p_surname, loc = :l:p_location_id from /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_partner/rows p where :l:p_partner_key =* :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, loc = :l:p_location_id from /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_partner/rows p where :l:p_partner_key =* :p:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 023_outer_reverse_const_on_inner_side
csv select :p:p_partner_key, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_partner/rows p where :l:p_partner_key =* :p:p_partner_key and :l:p_partner_key = '100005' and :p:p_partner_key >= '100000' and :p:p_partner_key < '100010' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_partner/rows p where :l:p_partner_key =* :p:p_partner_key and :l:p_partner_key = '100005' and :p:p_partner_key >= '100000' and :p:p_partner_key < '100010' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 024_outer_country_nulls_uk
csv select :l:p_partner_key, :l:p_location_id, cc = :l:p_country_code, cn = :co:p_country_name from /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_country/rows co where :l:p_country_code *= :co:p_country_code and :l:p_partner_key >= '100000' and :l:p_partner_key < '100030' and :l:p_country_code != 'US' order by :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :l:p_partner_key, :l:p_location_id, cc = :l:p_country_code, cn = :co:p_country_name from /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_country/rows co where :l:p_country_code *= :co:p_country_code and :l:p_partner_key >= '100000' and :l:p_partner_key < '100030' and :l:p_country_code != 'US' order by :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# 025_outer_antijoin_is_null
csv select :p:p_partner_key, :p:p_partner_class from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :l:p_partner_key is null and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key
csv set passthrough 0 select :p:p_partner_key, :p:p_partner_class from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :l:p_partner_key is null and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key

# 026_outer_is_not_null_on_outer
csv select :p:p_partner_key, loc = :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :l:p_location_id is not null and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key and :l:p_location_id is not null and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 027_outer_donor_isnull_in_where
csv select :p:p_partner_key, daf = :d:p_is_daf from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_donor/rows d where :p:p_partner_key *= :d:p_partner_key and isnull(:d:p_is_daf, 0) = 0 and :p:p_partner_key >= '100000' and :p:p_partner_key < '100030' order by :p:p_partner_key
csv set passthrough 0 select :p:p_partner_key, daf = :d:p_is_daf from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_donor/rows d where :p:p_partner_key *= :d:p_partner_key and isnull(:d:p_is_daf, 0) = 0 and :p:p_partner_key >= '100000' and :p:p_partner_key < '100030' order by :p:p_partner_key

# 028_outer_convert_on_earlier_declines
csv select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and convert(integer, :c:p_location_id) *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id, :l:p_city from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and convert(integer, :c:p_location_id) *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id

# 029_outer_multicol_c_l_nonconv_types
csv select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and :c:p_location_id *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and :c:p_location_id *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id

# 030_outer_left_leaf_then_group
csv select cl = :p:p_partner_class, n = count(1), nloc = count(:l:p_location_id) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key group by :p:p_partner_class order by :p:p_partner_class
csv set passthrough 0 select cl = :p:p_partner_class, n = count(1), nloc = count(:l:p_location_id) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key *= :l:p_partner_key group by :p:p_partner_class order by :p:p_partner_class
