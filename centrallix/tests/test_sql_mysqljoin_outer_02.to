##NAME Outer join conditions

# Show when joins are pushed down to MySQL
test 1

# outer_multicol_c_l_nonconv_types
csv select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and :c:p_location_id *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, loc = :l:p_location_id from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key *= :l:p_partner_key and :c:p_location_id *= :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100012' order by :c:p_partner_key, :c:p_contact_id, :l:p_revision_id

# outer_nonequi_selfjoin
csv select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_partner_key *= :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100030' order by :p1:p_partner_key, :p2:p_partner_key
csv set passthrough 0 select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_partner_key *= :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100030' order by :p1:p_partner_key, :p2:p_partner_key

# outer_cross_collation_surname_city
csv select :p:p_partner_key, :p:p_surname, lk = :l:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname *= :l:p_city and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' and :p:p_partner_class = 'IND' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, lk = :l:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_surname *= :l:p_city and :p:p_partner_key >= '100000' and :p:p_partner_key < '100011' and :p:p_partner_class = 'IND' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# outer_selfjoin_nonequi_extra_filter
csv select k1 = :l1:p_partner_key, a = :l1:p_location_id, b = :l2:p_location_id from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_partner_key *= :l2:p_partner_key and :l1:p_location_id < :l2:p_location_id and :l1:p_revision_id = 0 and :l2:p_revision_id = 0 and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100014' order by :l1:p_partner_key, :l1:p_location_id, :l2:p_location_id
csv set passthrough 0 select k1 = :l1:p_partner_key, a = :l1:p_location_id, b = :l2:p_location_id from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_partner_key *= :l2:p_partner_key and :l1:p_location_id < :l2:p_location_id and :l1:p_revision_id = 0 and :l2:p_revision_id = 0 and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100014' order by :l1:p_partner_key, :l1:p_location_id, :l2:p_location_id

# outer_selfjoin_surname_different_key
csv select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key, :p1:p_surname from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname *= :p2:p_surname and :p1:p_partner_key != :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100009' order by :p1:p_partner_key, :p2:p_partner_key
csv set passthrough 0 select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key, :p1:p_surname from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname *= :p2:p_surname and :p1:p_partner_key != :p2:p_partner_key and :p1:p_partner_key >= '100000' and :p1:p_partner_key < '100009' order by :p1:p_partner_key, :p2:p_partner_key
