##NAME Large joins

# Show when joins are pushed down to MySQL
test 1

# size_big_p_l_unfiltered
csv select :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100065' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100065' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# size_big_p_l_c_outer
csv select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :p:p_partner_key *= :c:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100050' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, loc = :l:p_location_id, con = :c:p_contact_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :p:p_partner_key *= :l:p_partner_key and :p:p_partner_key *= :c:p_partner_key and :p:p_partner_key >= '100040' and :p:p_partner_key < '100050' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id, :c:p_contact_id

# size_big_4way_unfiltered
csv select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, ctype = :ct:text from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :ct:tag = :c:p_contact_type and :l:p_revision_id = 0 and :p:p_partner_key >= '100000' and :p:p_partner_key < '100012' order by :p:p_partner_key, :l:p_location_id, :c:p_contact_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :c:p_contact_id, ctype = :ct:text from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/_p_contact_type/rows ct where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key and :ct:tag = :c:p_contact_type and :l:p_revision_id = 0 and :p:p_partner_key >= '100000' and :p:p_partner_key < '100012' order by :p:p_partner_key, :l:p_location_id, :c:p_contact_id

# size_big_selfjoin_contact_same_data
csv select k1 = :c1:p_partner_key, k2 = :c2:p_partner_key, :c1:p_contact_data from /tests/Test_DB/p_contact_info/rows c1, /tests/Test_DB/p_contact_info/rows c2 where :c1:p_contact_data = :c2:p_contact_data and :c1:p_partner_key < :c2:p_partner_key and :c1:p_contact_type = 'E' order by :c1:p_partner_key, :c1:p_contact_id, :c2:p_partner_key, :c2:p_contact_id
csv set passthrough 0 select k1 = :c1:p_partner_key, k2 = :c2:p_partner_key, :c1:p_contact_data from /tests/Test_DB/p_contact_info/rows c1, /tests/Test_DB/p_contact_info/rows c2 where :c1:p_contact_data = :c2:p_contact_data and :c1:p_partner_key < :c2:p_partner_key and :c1:p_contact_type = 'E' order by :c1:p_partner_key, :c1:p_contact_id, :c2:p_partner_key, :c2:p_contact_id

# count_big_join_no_order
csv select n = count(1), a = sum(:l:p_location_id), b = max(:c:p_contact_id) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key
csv set passthrough 0 select n = count(1), a = sum(:l:p_location_id), b = max(:c:p_contact_id) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l, /tests/Test_DB/p_contact_info/rows c where :l:p_partner_key = :p:p_partner_key and :c:p_partner_key = :p:p_partner_key

# big_nonindexed_join_contact_data_postal
csv select :c:p_partner_key, :c:p_contact_id, lpk = :l:p_partner_key, :l:p_postal_code from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_contact_data = :l:p_postal_code and :c:p_contact_type = 'E' order by :c:p_partner_key, :c:p_contact_id, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, lpk = :l:p_partner_key, :l:p_postal_code from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_contact_data = :l:p_postal_code and :c:p_contact_type = 'E' order by :c:p_partner_key, :c:p_contact_id, :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# big_selfjoin_loc_postal_code_group
csv select pc = :l1:p_postal_code, n = count(1) from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_postal_code = :l2:p_postal_code and :l1:p_partner_key < :l2:p_partner_key and :l1:p_postal_code >= '80900' and :l1:p_postal_code < '81000' group by :l1:p_postal_code order by :l1:p_postal_code
csv set passthrough 0 select pc = :l1:p_postal_code, n = count(1) from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_postal_code = :l2:p_postal_code and :l1:p_partner_key < :l2:p_partner_key and :l1:p_postal_code >= '80900' and :l1:p_postal_code < '81000' group by :l1:p_postal_code order by :l1:p_postal_code
