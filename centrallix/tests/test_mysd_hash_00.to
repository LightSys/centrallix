##NAME MySQL hash function

# empty table, and insert a single row to indicate a success
query DELETE FROM /tests/Test_DB/stringTests/rows
query insert into /tests/Test_DB/stringTests/rows SELECT a = 'test', b = 'hello world', c = 'HELLO WORLD'

# MD5 of empty string is well-known
csv SELECT test_hash_01 = "md5 of empty string"		FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('md5', '') = 'd41d8cd98f00b204e9800998ecf8427e'
csv SELECT test_hash_02 = "md5 of known value"		FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('md5', 'hello') = '5d41402abc4b2a76b9719d911017c592'
csv SELECT test_hash_03 = "md5 result is 32 chars"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND char_length(hash('md5', 'test')) = 32

# SHA1 of empty string
csv SELECT test_hash_04 = "sha1 of empty string"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha1', '') = 'da39a3ee5e6b4b0d3255bfef95601890afd80709'
csv SELECT test_hash_05 = "sha1 of known value"		FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha1', 'hello') = 'aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d'

# SHA256 of empty string
csv SELECT test_hash_06 = "sha256 of empty string"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha256', '') = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
csv SELECT test_hash_07 = "sha256 of known value"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha256', 'hello') = '2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824'

# SHA384
csv SELECT test_hash_08 = "sha384 of empty string" 	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha384', '') = '38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b'
csv SELECT test_hash_09 = "sha384 of known value" 	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha384', 'hello') = '59e1748777448c69de6b800d7a33bbfb9ff1b463e44354c3553bcdb9c666fa90125a3c79f90397bdf5f6a13de828684f'

# SHA512
csv SELECT test_hash_10 = "sha512 of empty string"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha512', '') = 'cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e'
csv SELECT test_hash_11 = "sha512 of known value" 	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('sha512', 'hello') = '9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca72323c3d99ba5c11d7c7acc6e14b8c5da0c4663475c2e5c3adef46f73bcdec043'

# Misc
csv SELECT test_hash_12 = "same input always produces same output"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('md5', 'consistent') = hash('md5', 'consistent')
csv SELECT test_hash_13 = "different inputs produce different output"	FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('md5', 'abc') != hash('md5', 'xyz')

# errors
csv SELECT test_error_01 = "Too many args"		FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('md5', 'test', 'error') IS NOT NULL
csv SELECT test_error_01 = "Too few args"		FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('md5') IS NOT NULL
csv SELECT test_error_01 = "Fake algorithm"		FROM /tests/Test_DB/stringTests/rows WHERE :a = 'test' AND hash('justHashIt✅️', 'test') IS NOT NULL

# cleanup
query DELETE FROM /tests/Test_DB/stringTests/rows
