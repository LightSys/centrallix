##NAME MySQL join pushdown, cases 104-116

# Show when joins are pushed down to MySQL
test 1

# 104_order_interleaved_sources
csv select :p:p_partner_key, :p:p_surname, :l:p_state_province, :l:p_city, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :l:p_state_province, :p:p_surname, :l:p_city, :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, :l:p_state_province, :l:p_city, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by :l:p_state_province, :p:p_surname, :l:p_city, :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 105_order_by_upper_expression
csv select :p:p_partner_key, :p:p_surname, :l:p_location_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by upper(:l:p_city), :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_surname, :l:p_location_id, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by upper(:l:p_city), :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 106_order_by_isnull_expr_later
csv select :p:p_partner_key, :l:p_state_province, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by isnull(:l:p_state_province, 'ZZ') desc, :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_state_province, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_partner_key >= '100000' and :p:p_partner_key < '100020' order by isnull(:l:p_state_province, 'ZZ') desc, :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# 107_group_given_name_trailing_space
csv select g = :p:p_given_name, n = count(1) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_given_name >= 'Al' and :p:p_given_name < 'Am' group by :p:p_given_name order by :p:p_given_name, char_length(:p:p_given_name)
csv set passthrough 0 select g = :p:p_given_name, n = count(1) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_given_name >= 'Al' and :p:p_given_name < 'Am' group by :p:p_given_name order by :p:p_given_name, char_length(:p:p_given_name)

# 108_group_surname_all
csv select s = :p:p_surname, n = count(1), mx = max(:l:p_location_id) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key group by :p:p_surname order by :p:p_surname, char_length(:p:p_surname), ascii(isnull(:p:p_surname, ''))
csv set passthrough 0 select s = :p:p_surname, n = count(1), mx = max(:l:p_location_id) from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key group by :p:p_surname order by :p:p_surname, char_length(:p:p_surname), ascii(isnull(:p:p_surname, ''))

