##NAME NULL comparisons

# Show when joins are pushed down to MySQL
test 1

# null_state_is_null_inner
csv select :p:p_partner_key, :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province is null order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_revision_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province is null order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# null_state_is_not_null_and_empty
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province is not null and :l:p_state_province = '' and :p:p_partner_key >= '100000' and :p:p_partner_key < '100200' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province is not null and :l:p_state_province = '' and :p:p_partner_key >= '100000' and :p:p_partner_key < '100200' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# neq_literal_with_nulls_inner
csv select :p:p_partner_key, :l:p_location_id, :l:p_state_province from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province != 'CO' and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_state_province from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province != 'CO' and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# not_eq_literal_with_nulls_inner
csv select :p:p_partner_key, :l:p_location_id, :l:p_state_province from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and not (:l:p_state_province = 'CO') and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_state_province from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and not (:l:p_state_province = 'CO') and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# neq_literal_with_nulls_first_source
csv select :p:p_partner_key, :p:p_given_name, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_given_name != 'David' and :p:p_partner_key < '100032' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_given_name, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_given_name != 'David' and :p:p_partner_key < '100032' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# null_eq_null_selfjoin_state
csv select k1 = :l1:p_partner_key, k2 = :l2:p_partner_key, st = :l1:p_state_province from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_state_province = :l2:p_state_province and :l1:p_partner_key < :l2:p_partner_key and :l1:p_partner_key >= '100004' and :l1:p_partner_key < '100012' and :l2:p_partner_key >= '100004' and :l2:p_partner_key < '100013' order by :l1:p_partner_key, :l2:p_partner_key, :l1:p_location_id, :l2:p_location_id, :l1:p_revision_id, :l2:p_revision_id
csv set passthrough 0 select k1 = :l1:p_partner_key, k2 = :l2:p_partner_key, st = :l1:p_state_province from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_state_province = :l2:p_state_province and :l1:p_partner_key < :l2:p_partner_key and :l1:p_partner_key >= '100004' and :l1:p_partner_key < '100012' and :l2:p_partner_key >= '100004' and :l2:p_partner_key < '100013' order by :l1:p_partner_key, :l2:p_partner_key, :l1:p_location_id, :l2:p_location_id, :l1:p_revision_id, :l2:p_revision_id

# null_ne_null_selfjoin_state
csv select k1 = :l1:p_partner_key, k2 = :l2:p_partner_key from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_state_province != :l2:p_state_province and :l1:p_partner_key >= '100005' and :l1:p_partner_key < '100012' and :l2:p_partner_key >= '100005' and :l2:p_partner_key < '100012' order by :l1:p_partner_key, :l2:p_partner_key, :l1:p_location_id, :l2:p_location_id, :l1:p_revision_id, :l2:p_revision_id
csv set passthrough 0 select k1 = :l1:p_partner_key, k2 = :l2:p_partner_key from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_state_province != :l2:p_state_province and :l1:p_partner_key >= '100005' and :l1:p_partner_key < '100012' and :l2:p_partner_key >= '100005' and :l2:p_partner_key < '100012' order by :l1:p_partner_key, :l2:p_partner_key, :l1:p_location_id, :l2:p_location_id, :l1:p_revision_id, :l2:p_revision_id

# null_lt_selfjoin_state
csv select k1 = :l1:p_partner_key, k2 = :l2:p_partner_key from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_state_province < :l2:p_state_province and :l1:p_partner_key >= '100004' and :l1:p_partner_key < '100012' and :l2:p_partner_key >= '100004' and :l2:p_partner_key < '100012' order by :l1:p_partner_key, :l2:p_partner_key, :l1:p_location_id, :l2:p_location_id, :l1:p_revision_id, :l2:p_revision_id
csv set passthrough 0 select k1 = :l1:p_partner_key, k2 = :l2:p_partner_key from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_state_province < :l2:p_state_province and :l1:p_partner_key >= '100004' and :l1:p_partner_key < '100012' and :l2:p_partner_key >= '100004' and :l2:p_partner_key < '100012' order by :l1:p_partner_key, :l2:p_partner_key, :l1:p_location_id, :l2:p_location_id, :l1:p_revision_id, :l2:p_revision_id

# in_list_with_null_and_empty
csv select :p:p_partner_key, :l:p_location_id, :l:p_state_province from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province in ('', 'CA', 'ZZ') and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id, :l:p_state_province from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :l:p_state_province in ('', 'CA', 'ZZ') and :p:p_partner_key < '100030' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id

# is_null_on_first_source_filter
csv select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_given_name is null and :p:p_partner_key < '102000' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :l:p_location_id from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_partner_key = :l:p_partner_key and :p:p_given_name is null and :p:p_partner_key < '102000' order by :p:p_partner_key, :l:p_location_id, :l:p_revision_id
