##NAME Levenshtein String Comparison

query select sw1 = 1 where lev_compare('hello', 'hello!', 20) >= 0 and lev_compare("hello","hello!", 20) <= 1
query select sw1 = 1 where lev_compare('hello', 'asdfkh', 20) >= 0 and lev_compare("hello","asdfkh", 20) <= 1
query select sw1 = 1 where lev_compare('hello', 'aaaaaaaaaaaaaaaaa', 20) >= 0 and lev_compare("hello","aaaaaaaaaaaaaaaaa", 20) <= 1
query select sw1 = 1 where lev_compare('hello', 'nope', 20) >= 0 and lev_compare("hello","nope", 20) <= 1
query select sw1 = 1 where lev_compare('below', 'hello!', 20) >= 0 and lev_compare("below","hello!", 20) <= 1
query select sw1 = 1 where lev_compare('kitten', 'smitten', 20) >= 0 and lev_compare("kitten","smitten", 20) <= 1
query select sw1 = 1 where lev_compare('hello', 'bobbobbobbob', 20) >= 0 and lev_compare("hello","bobbobbobbob", 20) <= 1
query select sw1 = 1 where lev_compare('hello', '', 20) >= 0 and lev_compare("hello","", 20) <= 1
query select sw1 = 1 where lev_compare('', '', 20) >= 0 and lev_compare("","", 20) <= 1
query select sw1 = 1 where lev_compare('blooooop', 'blob', 20) >= 0 and lev_compare("blooooop","blob", 20) <= 1
query select sw1 = 1 where lev_compare('', '!', 20) >= 0 and lev_compare("","!", 20) <= 1
query select sw1 = 1 where lev_compare('h', 'h', 20) >= 0 and lev_compare("h","h", 20) <= 1
query select sw1 = 1 where lev_compare('hi', 'hi', 20) >= 0 and lev_compare("hi","hi", 20) <= 1
