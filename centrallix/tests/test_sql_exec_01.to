##NAME EXEC and FROM parameter lists

csv exec /tests/testquery.qy ()
csv exec /tests/testquery.qy (id = 1 + 1)
csv exec /tests/testquery.qy (color = "r" + "ed", id = sqrt(16))
csv exec "/tests/testquery.qy" (color = "yellow", id = 5)
csv select * from /tests/testquery.qy (id = 1)
csv select :q:color from "/tests/testquery.qy" (color = "r" + "ed", id = 4) q
csv select * from expression ("/tests/" + "testquery.qy") (id = 3) q
csv select :q:rowid, :s:abbrev from /tests/testquery.qy (id = 2) q, /tests/States.csv/rows s where :s:id = :q:rowid
csv select :q:rowid, :q:color from paged expression ('/tests/testquery.qy') (id = :cx__page) q
csv select :q:rowid, :q:color from paged expression ('/tests/testquery.qy') (id = :cx__page * 2) q
csv select :s:abbrev, :q:color from /tests/States.csv/rows s, expression ('/tests/testquery.qy') (id = :s:id) q where :s:id <= 3
csv select :q:rowid, :q:color from paged /tests/testquery.qy (id = :cx__page) q
csv select :q:rowid, :q:color from paged "/tests/testquery.qy" (id = :cx__page * 2) q
csv select :s:abbrev, :q:color from /tests/States.csv/rows s, /tests/testquery.qy (id = :s:id) q where :s:id <= 3
csv select :s:abbrev, :q:color from /tests/testquery.qy (id = :s:id) q, /tests/States.csv/rows s where :s:id <= 3
csv select :s:abbrev, :q:color from /tests/States.csv/rows s, paged /tests/testquery.qy (id = :cx__page) q where :s:id = 1
csv select :s:abbrev, :q:color from /tests/States.csv/rows s, paged expression ('/tests/testquery.qy?id=' + :cx__page) q where :s:id = 1
csv select :q:rowid, :q:color from paged /tests/testquery.qy (id = isnull(:rowid + 1, 1)) q
csv select :q:rowid, :q:color from paged /tests/testquery.qy (id = isnull(:q:rowid + 1, 1)) q
csv select :s:abbrev, :q:rowid from /tests/States.csv/rows s, paged /tests/testquery.qy (id = isnull(:rowid + 1, 1)) q where :s:id <= 2
csv select :s:abbrev, :q:rowid from /tests/States.csv/rows s, paged /tests/testquery.qy (id = condition(:cx__page = 1, :s:id, -1)) q where :s:id <= 3 order by :q:rowid desc
csv select :s:abbrev, :q:rowid from paged /tests/testquery.qy (id = condition(:cx__page = 1, :s:id, -1)) q, /tests/States.csv/rows s where :s:id <= 3 order by :q:rowid desc
