##NAME MySQL join pushdown rules

# Show when joins are pushed down to MySQL
test 1

# rule_met_outer_last: pushed down, since the outer source z ends the join
csv select pk = :g0:p_partner_key, bid = :b:p_contact_id, btype = :b:p_contact_type, zid = :z:p_contact_id from /tests/Test_DB/p_partner/rows g0, /tests/Test_DB/p_contact_info/rows b, /tests/Test_DB/p_contact_info/rows z where :g0:p_partner_key = '100004' and :b:p_partner_key = :g0:p_partner_key and :b:p_partner_key *= :z:p_partner_key and :b:p_contact_id *= :z:p_contact_id and :z:p_contact_type = 'P'
csv set passthrough 0 select pk = :g0:p_partner_key, bid = :b:p_contact_id, btype = :b:p_contact_type, zid = :z:p_contact_id from /tests/Test_DB/p_partner/rows g0, /tests/Test_DB/p_contact_info/rows b, /tests/Test_DB/p_contact_info/rows z where :g0:p_partner_key = '100004' and :b:p_partner_key = :g0:p_partner_key and :b:p_partner_key *= :z:p_partner_key and :b:p_contact_id *= :z:p_contact_id and :z:p_contact_type = 'P'

# rule_failed_inner_after_outer: not pushed down, since inner source w follows outer source z and depends on g0
csv select pk = :g0:p_partner_key, bid = :b:p_contact_id, btype = :b:p_contact_type, zid = :z:p_contact_id, wid = :w:p_contact_id from /tests/Test_DB/p_partner/rows g0, /tests/Test_DB/p_contact_info/rows b, /tests/Test_DB/p_contact_info/rows z, /tests/Test_DB/p_contact_info/rows w where :g0:p_partner_key = '100004' and :b:p_partner_key = :g0:p_partner_key and :b:p_partner_key *= :z:p_partner_key and :b:p_contact_id *= :z:p_contact_id and :z:p_contact_type = 'P' and :w:p_partner_key = :g0:p_partner_key and :w:p_contact_id = :z:p_contact_id
csv set passthrough 0 select pk = :g0:p_partner_key, bid = :b:p_contact_id, btype = :b:p_contact_type, zid = :z:p_contact_id, wid = :w:p_contact_id from /tests/Test_DB/p_partner/rows g0, /tests/Test_DB/p_contact_info/rows b, /tests/Test_DB/p_contact_info/rows z, /tests/Test_DB/p_contact_info/rows w where :g0:p_partner_key = '100004' and :b:p_partner_key = :g0:p_partner_key and :b:p_partner_key *= :z:p_partner_key and :b:p_contact_id *= :z:p_contact_id and :z:p_contact_type = 'P' and :w:p_partner_key = :g0:p_partner_key and :w:p_contact_id = :z:p_contact_id
