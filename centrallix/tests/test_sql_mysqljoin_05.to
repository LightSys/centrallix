##NAME MySQL join pushdown, cases 042-051

# Show when joins are pushed down to MySQL
test 1

# 042_coll_surname_powell_trailing
csv select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key, s1 = :p1:p_surname, s2 = :p2:p_surname from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname = :p2:p_surname and :p1:p_partner_key < :p2:p_partner_key and :p1:p_surname = 'Powell' and :p1:p_partner_key < '100050' and :p2:p_partner_key < '100050' order by :p1:p_partner_key, :p2:p_partner_key
csv set passthrough 0 select k1 = :p1:p_partner_key, k2 = :p2:p_partner_key, s1 = :p1:p_surname, s2 = :p2:p_surname from /tests/Test_DB/p_partner/rows p1, /tests/Test_DB/p_partner/rows p2 where :p1:p_surname = :p2:p_surname and :p1:p_partner_key < :p2:p_partner_key and :p1:p_surname = 'Powell' and :p1:p_partner_key < '100050' and :p2:p_partner_key < '100050' order by :p1:p_partner_key, :p2:p_partner_key

# 043_coll_given_vs_surname_cross_table
csv select :p:p_partner_key, :p:p_given_name, lk = :l:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_given_name = :l:p_city and :p:p_partner_key >= '100000' and :p:p_partner_key < '101500' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :p:p_partner_key, :p:p_given_name, lk = :l:p_partner_key, :l:p_city from /tests/Test_DB/p_partner/rows p, /tests/Test_DB/p_location/rows l where :p:p_given_name = :l:p_city and :p:p_partner_key >= '100000' and :p:p_partner_key < '101500' order by :p:p_partner_key, :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# 044_coll_city_selfjoin_loc
csv select n = count(1), mn = min(:l1:p_partner_key) from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_city = :l2:p_city and :l1:p_partner_key < :l2:p_partner_key and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100030'
csv set passthrough 0 select n = count(1), mn = min(:l1:p_partner_key) from /tests/Test_DB/p_location/rows l1, /tests/Test_DB/p_location/rows l2 where :l1:p_city = :l2:p_city and :l1:p_partner_key < :l2:p_partner_key and :l1:p_partner_key >= '100000' and :l1:p_partner_key < '100030'

# 045_coll_contact_data_vs_location_addr
csv select :c:p_partner_key, :c:p_contact_id, :c:p_contact_data, lk = :l:p_partner_key from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_contact_data = :l:p_address_1 and :c:p_partner_key >= '100000' and :c:p_partner_key < '100060' order by :c:p_partner_key, :c:p_contact_id, :l:p_partner_key, :l:p_location_id, :l:p_revision_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, :c:p_contact_data, lk = :l:p_partner_key from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_contact_data = :l:p_address_1 and :c:p_partner_key >= '100000' and :c:p_partner_key < '100060' order by :c:p_partner_key, :c:p_contact_id, :l:p_partner_key, :l:p_location_id, :l:p_revision_id

# 046_type_string_vs_int_loc_id
csv select :c:p_partner_key, :c:p_contact_id, cl = :c:p_location_id, ll = :l:p_location_id from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key = :l:p_partner_key and :c:p_location_id = :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100020' and :l:p_revision_id = 0 order by :c:p_partner_key, :c:p_contact_id, :l:p_location_id
csv set passthrough 0 select :c:p_partner_key, :c:p_contact_id, cl = :c:p_location_id, ll = :l:p_location_id from /tests/Test_DB/p_contact_info/rows c, /tests/Test_DB/p_location/rows l where :c:p_partner_key = :l:p_partner_key and :c:p_location_id = :l:p_location_id and :c:p_partner_key >= '100000' and :c:p_partner_key < '100020' and :l:p_revision_id = 0 order by :c:p_partner_key, :c:p_contact_id, :l:p_location_id

