##NAME ON DUP clause, IF MODIFIED after copying objcontent onto itself
##UNDO /tests/upsert_content/dst

query insert into /tests/upsert_content/dst select :name from /tests/upsert_content/dst t1 on duplicate :name update set :objcontent = :t1:objcontent, :annotation = 'modified' if modified
csv select :name, :annotation, :size from /tests/upsert_content/dst order by :name
